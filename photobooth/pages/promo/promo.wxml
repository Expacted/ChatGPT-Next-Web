<view class="page promo-page">
  <view class="headline" style="margin-top:0;font-size:34rpx;">分享推广</view>
  <view class="sub">把小程序转给好友，带上你的邀请码，方便统计来源</view>

  <view class="code-card">
    <text class="code-label">我的邀请码</text>
    <text class="code">{{inviteCode}}</text>
    <view class="copy" bindtap="onCopy">复制邀请码</view>
  </view>

  <view class="steps">
    <view class="step-item"><text class="n">1</text><text>点下方转发给好友 / 朋友圈</text></view>
    <view class="step-item"><text class="n">2</text><text>好友打开后首页会显示邀请码</text></view>
    <view class="step-item"><text class="n">3</text><text>好友预约时会带上来源，方便你跟进</text></view>
  </view>

  <button class="cta" open-type="share">转发给好友</button>
  <button class="cta cta-ghost" style="margin-top:20rpx;" bindtap="onBook">邀请好友来预约</button>

  <view class="stat" wx:if="{{openCount}}">本机记录：邀请码被打开约 {{openCount}} 次</view>
</view>
