<view class="page mine-page">
  <view class="card profile">
    <view class="avatar">🙂</view>
    <view>
      <text class="name">微信用户</text>
      <text class="role">顾客</text>
    </view>
  </view>

  <view class="card menu">
    <view class="menu-item" bindtap="onOrders">
      <text>我的订单</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onPromo">
      <text>分享推广</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onShoot">
      <text>现场体验拍摄</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onPrice">
      <text>价目服务表</text>
      <text class="arrow">›</text>
    </view>
  </view>
</view>
