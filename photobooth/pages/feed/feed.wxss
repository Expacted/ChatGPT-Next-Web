.feed-page {
  height: 100vh;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.post {
  margin-bottom: 20rpx;
}

.post-head {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  background: linear-gradient(145deg, #f3b6c8, #a88bd6);
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.name {
  display: block;
  font-size: 26rpx;
  font-weight: 650;
}

.time {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--muted);
}

.text {
  display: block;
  margin: 20rpx 0 16rpx;
  font-size: 28rpx;
  line-height: 1.55;
}

.grid {
  display: grid;
  gap: 8rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.grid-2 {
  grid-template-columns: 1fr 1fr;
}

.grid-3 {
  grid-template-columns: 1fr 1fr 1fr;
}

.grid-9 {
  grid-template-columns: 1fr 1fr 1fr;
}

.cell {
  aspect-ratio: 1;
  background: #e8ddd2;
}

.tone-1 { background: linear-gradient(135deg, #f3d0c4, #e8b8c8); }
.tone-2 { background: linear-gradient(135deg, #d9c8f0, #c4dce8); }
.tone-3 { background: linear-gradient(135deg, #e8dcc8, #f0c8d0); }
.tone-4 { background: linear-gradient(135deg, #cfe6dc, #e8d4c4); }
.tone-5 { background: linear-gradient(135deg, #f0d8b8, #d8c4e8); }
.tone-6 { background: linear-gradient(135deg, #e0d0c4, #f0c8c0); }
.tone-7 { background: linear-gradient(135deg, #d0dce8, #e8d0dc); }
.tone-8 { background: linear-gradient(135deg, #e8e0d0, #c8d8d0); }
.tone-9 { background: linear-gradient(135deg, #f0d0d8, #d8c8e0); }

.end {
  text-align: center;
  color: var(--muted);
  font-size: 22rpx;
  padding: 16rpx 0 40rpx;
}
