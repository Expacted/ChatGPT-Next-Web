.form {
  margin-top: 36rpx;
}

.field {
  margin-bottom: 28rpx;
}

.label {
  display: block;
  font-size: 24rpx;
  color: var(--muted);
  margin-bottom: 12rpx;
}

.input,
.picker {
  width: 100%;
  height: 88rpx;
  padding: 0 28rpx;
  border-radius: 20rpx;
  background: var(--bg-soft);
  border: 2rpx solid var(--line);
  color: var(--ink);
  font-size: 28rpx;
  display: flex;
  align-items: center;
}

.people {
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.step {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 2rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: var(--ink);
}

.num {
  font-size: 34rpx;
  font-weight: 600;
  min-width: 40rpx;
  text-align: center;
}

.remind-card {
  margin-top: 12rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: rgba(232, 93, 76, 0.1);
  border: 2rpx solid rgba(232, 93, 76, 0.25);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.remind-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
}

.remind-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.switch {
  width: 88rpx;
  height: 52rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
  padding: 4rpx;
  flex-shrink: 0;
  transition: background 0.2s;
}

.switch.on {
  background: var(--accent);
}

.knob {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #fff;
  transition: transform 0.2s;
}

.switch.on .knob {
  transform: translateX(36rpx);
}

.hint {
  margin-top: 20rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--muted);
}
