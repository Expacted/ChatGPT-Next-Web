<view class="page success-page">
  <view class="ok-mark">✓</view>
  <view class="headline" style="margin-top:24rpx;font-size:36rpx;">预约已确认</view>
  <view class="sub">{{booking.date}} {{booking.time}} · {{booking.people}} 人</view>

  <view class="card">
    <view class="row"><text class="k">昵称</text><text class="v">{{booking.name}}</text></view>
    <view class="row" wx:if="{{booking.phone}}"><text class="k">手机</text><text class="v">{{booking.phone}}</text></view>
    <view class="row" wx:if="{{booking.note}}"><text class="k">备注</text><text class="v">{{booking.note}}</text></view>
    <view class="row">
      <text class="k">提醒</text>
      <text class="v">{{remindText}}</text>
    </view>
    <view class="row"><text class="k">存储</text><text class="v">{{viaText}}</text></view>
  </view>

  <button class="cta" open-type="share">分享给好友</button>
  <button class="cta cta-ghost" style="margin-top:20rpx;" bindtap="onHome">回首页</button>
  <button class="cta cta-ghost" style="margin-top:20rpx;" bindtap="onList">查看我的预约</button>
</view>
