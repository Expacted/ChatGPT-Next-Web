.success-page {
  display: flex;
  flex-direction: column;
}

.ok-mark {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(168, 139, 214, 0.16);
  color: var(--accent);
  font-size: 48rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 12rpx;
}

.detail {
  margin: 32rpx 0 12rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 18rpx 0;
  font-size: 26rpx;
}

.row + .row {
  border-top: 2rpx solid var(--line);
}

.k {
  color: var(--muted);
  flex-shrink: 0;
}

.v {
  text-align: right;
  word-break: break-all;
}
