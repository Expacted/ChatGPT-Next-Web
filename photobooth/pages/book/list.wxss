.list {
  margin: 28rpx 0 8rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.item-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.when {
  font-size: 30rpx;
  font-weight: 700;
}

.tag {
  font-size: 20rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(168, 139, 214, 0.14);
  color: #7a5fb0;
}

.meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.note {
  margin-top: 8rpx;
  font-size: 24rpx;
}
