.list {
  margin: 32rpx 0 12rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.item {
  padding: 28rpx;
  border-radius: 24rpx;
  background: var(--bg-soft);
  border: 2rpx solid var(--line);
}

.item-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.when {
  font-size: 30rpx;
  font-weight: 600;
}

.tag {
  font-size: 20rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(232, 93, 76, 0.16);
  color: var(--accent-soft);
}

.item-meta {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.item-note {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--ink);
  opacity: 0.85;
}
