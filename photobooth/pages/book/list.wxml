<view class="page">
  <view class="section-title">我的订单</view>
  <view class="section-sub" wx:if="{{!list.length}}">还没有需求单，去预约一个活动吧</view>

  <view class="list" wx:if="{{list.length}}">
    <view class="card item" wx:for="{{list}}" wx:key="id">
      <view class="item-top">
        <text class="when">{{item.date}}</text>
        <text class="tag">{{item.remind && item.remindAccepted ? '已提醒' : (item.remind ? '待提醒' : '需求单')}}</text>
      </view>
      <view class="meta">{{item.activityType || '活动'}} · {{item.packageLabel || item.time}} · {{item.city || ''}}</view>
      <view class="meta">{{item.name}}{{item.phone ? ' · ' + item.phone : ''}}</view>
      <view class="note" wx:if="{{item.note}}">{{item.note}}</view>
    </view>
  </view>

  <button class="cta" bindtap="onBook">{{list.length ? '再约一次' : '去预约'}}</button>
</view>
