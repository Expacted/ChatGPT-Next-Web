.result-page {
  display: flex;
  flex-direction: column;
  align-items: stretch;
}

.result-wrap {
  margin: 40rpx auto;
  padding: 12rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 2rpx solid var(--line);
  max-width: 520rpx;
  animation: rise 0.55s cubic-bezier(0.22, 1, 0.36, 1) both;
}

.result-img {
  width: 100%;
  display: block;
  border-radius: 12rpx;
}

@keyframes rise {
  from {
    opacity: 0;
    transform: translateY(24rpx) scale(0.98);
  }
  to {
    opacity: 1;
    transform: none;
  }
}
